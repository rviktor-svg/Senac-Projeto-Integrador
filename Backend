package br.com.senac.bookexchange;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.web.servlet.config.annotation.CorsRegistry;
import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;
import org.springframework.context.annotation.Bean;

@SpringBootApplication
public class BookExchangeApplication {

    public static void main(String[] args) {
        SpringApplication.run(BookExchangeApplication.class, args);
    }

    // Libera o consumo da API pelo frontend Angular (rodando em outra porta)
    @Bean
    public WebMvcConfigurer corsConfigurer() {
        return new WebMvcConfigurer() {
            @Override
            public void addCorsMappings(CorsRegistry registry) {
                registry.addMapping("/api/**")
                        .allowedOrigins("http://localhost:4200")
                        .allowedMethods("GET", "POST", "PUT", "DELETE");
            }
        };
    }
}

package br.com.senac.bookexchange.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.web.servlet.config.annotation.InterceptorRegistry;
import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;

@Configuration
public class AuthConfig implements WebMvcConfigurer {

    /** Transforma a senha em hash (BCrypt) antes de gravar no banco. */
    @Bean
    public PasswordEncoder passwordEncoder() {
        return new BCryptPasswordEncoder();
    }

    /** Liga o "porteiro" em todas as rotas da API. */
    @Override
    public void addInterceptors(InterceptorRegistry registry) {
        registry.addInterceptor(new AuthInterceptor()).addPathPatterns("/api/**");
    }
}

package br.com.senac.bookexchange.config;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;
import org.springframework.web.servlet.HandlerInterceptor;

/**
 * "Porteiro" da API: toda chamada em /api/** só passa se houver um login (sessão),
 * exceto as poucas rotas públicas listadas abaixo.
 */
public class AuthInterceptor implements HandlerInterceptor {

    @Override
    public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler)
            throws Exception {
        if (rotaPublica(request)) return true;

        HttpSession session = request.getSession(false);
        if (session != null && session.getAttribute("usuarioId") != null) return true;

        response.setStatus(HttpServletResponse.SC_UNAUTHORIZED);
        response.setContentType("application/json;charset=UTF-8");
        response.getWriter().write("{\"message\":\"Você precisa entrar para continuar.\"}");
        return false;
    }

    private boolean rotaPublica(HttpServletRequest request) {
        String metodo = request.getMethod();
        String caminho = request.getRequestURI();
        if ("OPTIONS".equals(metodo)) return true;
        if ("POST".equals(metodo)) {
            return caminho.equals("/api/auth/login")
                || caminho.equals("/api/auth/logout")
                || caminho.equals("/api/usuarios/cadastro");
        }
        // o catálogo de troca pode ser visto sem login
        return "GET".equals(metodo) && caminho.equals("/api/livros/catalogo");
    }
}

package br.com.senac.bookexchange.controller;

import br.com.senac.bookexchange.model.Usuario;
import br.com.senac.bookexchange.repository.UsuarioRepository;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpSession;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.web.bind.annotation.*;

import java.util.Map;

@RestController
@RequestMapping("/api/auth")
public class AuthController {

    public record LoginRequest(String email, String senha) {}
    public record UsuarioLogado(Long id, String nome) {}

    private final UsuarioRepository usuarioRepository;
    private final PasswordEncoder passwordEncoder;

    public AuthController(UsuarioRepository usuarioRepository, PasswordEncoder passwordEncoder) {
        this.usuarioRepository = usuarioRepository;
        this.passwordEncoder = passwordEncoder;
    }

    // POST /api/auth/login  {email, senha}
    @PostMapping("/login")
    public ResponseEntity<?> login(@RequestBody LoginRequest req, HttpServletRequest request) {
        if (req.email() == null || req.email().isBlank() || req.senha() == null || req.senha().isEmpty()) {
            return erro(HttpStatus.BAD_REQUEST, "Informe e-mail e senha.");
        }
        Usuario usuario = usuarioRepository.findByEmailIgnoreCase(req.email().trim()).orElse(null);
        if (usuario == null || !senhaConfere(usuario, req.senha())) {
            // mesma mensagem nos dois casos, para não revelar quais e-mails existem
            return erro(HttpStatus.UNAUTHORIZED, "E-mail ou senha incorretos.");
        }

        request.getSession();          // garante que existe uma sessão
        request.changeSessionId();     // novo número de sessão a cada login (evita fixação de sessão)
        request.getSession().setAttribute("usuarioId", usuario.getId());
        return ResponseEntity.ok(new UsuarioLogado(usuario.getId(), usuario.getNome()));
    }

    // POST /api/auth/logout
    @PostMapping("/logout")
    public ResponseEntity<Void> logout(HttpServletRequest request) {
        HttpSession session = request.getSession(false);
        if (session != null) session.invalidate();
        return ResponseEntity.noContent().build();
    }

    // GET /api/auth/me -> quem está logado agora
    @GetMapping("/me")
    public ResponseEntity<?> me(@SessionAttribute("usuarioId") Long usuarioLogadoId) {
        Usuario usuario = usuarioRepository.findById(usuarioLogadoId).orElse(null);
        if (usuario == null) return erro(HttpStatus.UNAUTHORIZED, "Sessão inválida.");
        return ResponseEntity.ok(new UsuarioLogado(usuario.getId(), usuario.getNome()));
    }

    private boolean senhaConfere(Usuario usuario, String senhaDigitada) {
        String guardada = usuario.getSenhaHash();
        if (guardada == null) return false;
        if (guardada.startsWith("$2")) {
            return passwordEncoder.matches(senhaDigitada, guardada);
        }
        // Conta antiga, criada quando a senha ainda era salva em texto puro:
        // confere e já converte para BCrypt. (Pode ser removido depois que todos entrarem uma vez.)
        if (guardada.equals(senhaDigitada)) {
            usuario.setSenhaHash(passwordEncoder.encode(senhaDigitada));
            usuarioRepository.save(usuario);
            return true;
        }
        return false;
    }

    private ResponseEntity<Map<String, String>> erro(HttpStatus status, String mensagem) {
        return ResponseEntity.status(status).body(Map.of("message", mensagem));
    }
}

package br.com.senac.bookexchange.controller;

import br.com.senac.bookexchange.dto.InteresseDTO;
import br.com.senac.bookexchange.model.Interesse;
import br.com.senac.bookexchange.model.Livro;
import br.com.senac.bookexchange.model.Usuario;
import br.com.senac.bookexchange.repository.InteresseRepository;
import br.com.senac.bookexchange.repository.LivroRepository;
import br.com.senac.bookexchange.repository.UsuarioRepository;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

@RestController
@RequestMapping("/api/interesses")
public class InteresseController {

    private final InteresseRepository interesseRepository;
    private final LivroRepository livroRepository;
    private final UsuarioRepository usuarioRepository;

    public InteresseController(InteresseRepository interesseRepository,
                               LivroRepository livroRepository,
                               UsuarioRepository usuarioRepository) {
        this.interesseRepository = interesseRepository;
        this.livroRepository = livroRepository;
        this.usuarioRepository = usuarioRepository;
    }

    // POST /api/interesses  {livroId} -> quem demonstra interesse é SEMPRE quem está logado
    @PostMapping
    public ResponseEntity<?> demonstrar(@RequestBody InteresseDTO dto,
                                        @SessionAttribute("usuarioId") Long usuarioLogadoId) {
        if (dto.getLivroId() == null) {
            return erro(HttpStatus.BAD_REQUEST, "Informe o livro.");
        }
        Livro livro = livroRepository.findById(dto.getLivroId()).orElse(null);
        if (livro == null) return erro(HttpStatus.NOT_FOUND, "Livro não encontrado.");

        Usuario interessado = usuarioRepository.findById(usuarioLogadoId).orElse(null);
        if (interessado == null) return erro(HttpStatus.UNAUTHORIZED, "Sessão inválida.");

        if (livro.getDisponibilidade() != Livro.Disponibilidade.TROCA) {
            return erro(HttpStatus.CONFLICT, "Este livro não está disponível para troca.");
        }
        if (livro.getUsuario().getId().equals(interessado.getId())) {
            return erro(HttpStatus.BAD_REQUEST, "Você não pode demonstrar interesse no seu próprio livro.");
        }
        if (interesseRepository.existsByLivroIdAndUsuarioInteressadoId(livro.getId(), interessado.getId())) {
            return erro(HttpStatus.CONFLICT, "Você já demonstrou interesse neste livro.");
        }

        Interesse interesse = Interesse.builder()
                .livro(livro)
                .usuarioInteressado(interessado)
                .status(Interesse.Status.PENDENTE)
                .build();
        return ResponseEntity.status(HttpStatus.CREATED).body(toDTO(interesseRepository.save(interesse)));
    }

    // GET /api/interesses/enviados -> interesses que EU demonstrei
    @GetMapping("/enviados")
    public List<InteresseDTO> enviados(@SessionAttribute("usuarioId") Long usuarioLogadoId) {
        return interesseRepository.findByUsuarioInteressadoId(usuarioLogadoId).stream()
                .map(this::toDTO).collect(Collectors.toList());
    }

    // GET /api/interesses/recebidos -> interesses nos MEUS livros
    @GetMapping("/recebidos")
    public List<InteresseDTO> recebidos(@SessionAttribute("usuarioId") Long usuarioLogadoId) {
        return interesseRepository.findByLivroUsuarioId(usuarioLogadoId).stream()
                .map(this::toDTO).collect(Collectors.toList());
    }

    // PUT /api/interesses/{id}/status?valor=ACEITO -> só o DONO do livro pode responder
    @PutMapping("/{id}/status")
    public ResponseEntity<?> responder(@PathVariable Long id,
                                       @RequestParam Interesse.Status valor,
                                       @SessionAttribute("usuarioId") Long usuarioLogadoId) {
        Interesse interesse = interesseRepository.findById(id).orElse(null);
        if (interesse == null) return erro(HttpStatus.NOT_FOUND, "Interesse não encontrado.");
        if (!interesse.getLivro().getUsuario().getId().equals(usuarioLogadoId)) {
            return erro(HttpStatus.FORBIDDEN, "Só o dono do livro pode responder a este interesse.");
        }
        if (valor == Interesse.Status.PENDENTE) {
            return erro(HttpStatus.BAD_REQUEST, "Use ACEITO ou RECUSADO.");
        }
        interesse.setStatus(valor);
        return ResponseEntity.ok(toDTO(interesseRepository.save(interesse)));
    }

    private ResponseEntity<Map<String, String>> erro(HttpStatus status, String mensagem) {
        return ResponseEntity.status(status).body(Map.of("message", mensagem));
    }

    private InteresseDTO toDTO(Interesse i) {
        return InteresseDTO.builder()
                .id(i.getId())
                .livroId(i.getLivro().getId())
                .tituloLivro(i.getLivro().getTitulo())
                .nomeDonoLivro(i.getLivro().getUsuario().getNome())
                .usuarioInteressadoId(i.getUsuarioInteressado().getId())
                .nomeInteressado(i.getUsuarioInteressado().getNome())
                .status(i.getStatus())
                .criadoEm(i.getCriadoEm())
                .build();
    }
}

package br.com.senac.bookexchange.controller;

import br.com.senac.bookexchange.dto.LivroDTO;
import br.com.senac.bookexchange.model.Livro;
import br.com.senac.bookexchange.model.Usuario;
import br.com.senac.bookexchange.repository.LivroRepository;
import br.com.senac.bookexchange.repository.UsuarioRepository;
import jakarta.validation.Valid;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

@RestController
@RequestMapping("/api/livros")
public class LivroController {

    private final LivroRepository livroRepository;
    private final UsuarioRepository usuarioRepository;

    public LivroController(LivroRepository livroRepository, UsuarioRepository usuarioRepository) {
        this.livroRepository = livroRepository;
        this.usuarioRepository = usuarioRepository;
    }

    // GET /api/livros/estante -> a estante de QUEM ESTÁ LOGADO
    @GetMapping("/estante")
    public List<LivroDTO> minhaEstante(@SessionAttribute("usuarioId") Long usuarioLogadoId) {
        return livroRepository.findByUsuarioId(usuarioLogadoId).stream()
                .map(this::toDTO).collect(Collectors.toList());
    }

    // GET /api/livros/catalogo?genero=Romance -> público (não exige login)
    @GetMapping("/catalogo")
    public List<LivroDTO> catalogo(@RequestParam(required = false) String genero) {
        List<Livro> livros = (genero == null || genero.isBlank())
                ? livroRepository.findByDisponibilidade(Livro.Disponibilidade.TROCA)
                : livroRepository.findByDisponibilidadeAndGeneroContainingIgnoreCase(
                        Livro.Disponibilidade.TROCA, genero);
        return livros.stream().map(this::toDTO).collect(Collectors.toList());
    }

    // POST /api/livros -> o dono do livro é SEMPRE quem está logado (o usuarioId do JSON é ignorado)
    @PostMapping
    public ResponseEntity<?> cadastrar(@Valid @RequestBody LivroDTO dto,
                                       @SessionAttribute("usuarioId") Long usuarioLogadoId) {
        Usuario usuario = usuarioRepository.findById(usuarioLogadoId).orElse(null);
        if (usuario == null) return erro(HttpStatus.UNAUTHORIZED, "Sessão inválida.");

        Livro livro = Livro.builder()
                .usuario(usuario)
                .titulo(dto.getTitulo())
                .autor(dto.getAutor())
                .genero(dto.getGenero())
                .estadoConservacao(dto.getEstadoConservacao())
                .disponibilidade(dto.getDisponibilidade() == null
                        ? Livro.Disponibilidade.COLECAO : dto.getDisponibilidade())
                .build();

        return ResponseEntity.ok(toDTO(livroRepository.save(livro)));
    }

    // PUT /api/livros/{id}/disponibilidade?valor=TROCA -> só o dono pode alterar
    @PutMapping("/{id}/disponibilidade")
    public ResponseEntity<?> alternarDisponibilidade(@PathVariable Long id,
                                                     @RequestParam Livro.Disponibilidade valor,
                                                     @SessionAttribute("usuarioId") Long usuarioLogadoId) {
        Livro livro = livroRepository.findById(id).orElse(null);
        if (livro == null) return erro(HttpStatus.NOT_FOUND, "Livro não encontrado.");
        if (!livro.getUsuario().getId().equals(usuarioLogadoId)) {
            return erro(HttpStatus.FORBIDDEN, "Este livro não é seu.");
        }
        livro.setDisponibilidade(valor);
        return ResponseEntity.ok(toDTO(livroRepository.save(livro)));
    }

    // DELETE /api/livros/{id} -> só o dono pode remover
    @DeleteMapping("/{id}")
    public ResponseEntity<?> remover(@PathVariable Long id,
                                     @SessionAttribute("usuarioId") Long usuarioLogadoId) {
        Livro livro = livroRepository.findById(id).orElse(null);
        if (livro == null) return erro(HttpStatus.NOT_FOUND, "Livro não encontrado.");
        if (!livro.getUsuario().getId().equals(usuarioLogadoId)) {
            return erro(HttpStatus.FORBIDDEN, "Este livro não é seu.");
        }
        livroRepository.deleteById(id);
        return ResponseEntity.noContent().build();
    }

    private ResponseEntity<Map<String, String>> erro(HttpStatus status, String mensagem) {
        return ResponseEntity.status(status).body(Map.of("message", mensagem));
    }

    private LivroDTO toDTO(Livro l) {
        return LivroDTO.builder()
                .id(l.getId())
